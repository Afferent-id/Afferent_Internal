# =============================================================================
# HUMAN FIREWALL (AFFERENT) — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =============================================================================
# Petunjuk:
# 1. Salin file ini menjadi .env:
#    cp .env.example .env (Linux/macOS) atau copy .env.example .env (Windows)
# 2. Isi nilai-nilai API key dan kredensial di bawah ini sesuai kebutuhan.
# 3. PENTING: Jangan pernah commit file .env ke repository publik/GitHub!
# =============================================================================

# -----------------------------------------------------------------------------
# 1. FLASK BACKEND CORE & SECURITY
# -----------------------------------------------------------------------------
# Generate key aman via Python: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_super_secret_flask_key_here
ADMIN_PASSWORD=change_this_admin_password_in_production
SERVICE_API_KEY=your_internal_service_to_service_api_key_here

# Mode Development: Set "true" untuk bypass authentication guard saat dev/testing.
# WAJIB set "false" pada environment staging/production!
DEV_BYPASS_AUTH=false

# Flask Debugging (true / false)
FLASK_DEBUG=true

# -----------------------------------------------------------------------------
# 2. AI ROUTER & MULTI-LLM FAILOVER CHAIN
# -----------------------------------------------------------------------------
# ai_router.py mengeksekusi failover otomatis: OpenRouter (Primary) -> Google Gemini -> Groq

# --- Provider 1: OpenRouter (Primary) ---
# Dapatkan API key gratis di: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Pilihan model gratis yang didukung:
# - meta-llama/llama-3.3-70b-instruct:free
# - qwen/qwen3-coder:free
# - deepseek/deepseek-v4-flash:free
# - openrouter/free
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Provider 2: Google Gemini Native SDK (Secondary Fallback) ---
# Dapatkan API key gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here

# --- Provider 3: Groq Cloud API (Final Fallback) ---
# Dapatkan API key gratis di: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- Web Scraper: Firecrawl (Optional untuk Generator Template AI) ---
# Dapatkan API key gratis di: https://firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# -----------------------------------------------------------------------------
# 3. INFRASTRUCTURE & NETWORK CONFIGURATION
# -----------------------------------------------------------------------------
# Daftar origin yang diizinkan untuk CORS (pisahkan dengan koma)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Base URL publik sistem
SERVER_BASE_URL=http://localhost:5000
SIMULATION_BASE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# 4. GOPHISH SIMULATION ENGINE (FLOW A)
# -----------------------------------------------------------------------------
# API key admin GoPhish (didapatkan dari UI GoPhish Settings / terminal log saat pertama deploy)
GOPHISH_API_KEY=your_gophish_admin_api_key_here
GOPHISH_API_URL=https://gophish:3333

# -----------------------------------------------------------------------------
# 5. TELEGRAM BOT & SOC NOTIFICATIONS (FLOW B)
# -----------------------------------------------------------------------------
# Username bot tanpa '@' (misal: HFL_Notif_Bot)
BOT_USERNAME=your_telegram_bot_username

# Token bot dari @BotFather (format: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# ID Grup Telegram SOC untuk penerimaan eskalasi insiden (misal: -1001234567890)
SOC_CHAT_ID=-1001234567890

# -----------------------------------------------------------------------------
# 6. N8N ORCHESTRATOR & WEBHOOK TUNNELING
# -----------------------------------------------------------------------------
# URL tunnel publik (Pinggy / Cloudflare Tunnel / domain resmi) untuk menerima webhook Telegram
# Contoh: https://your-subdomain.trycloudflare.com atau https://your-tunnel.a.pinggy.link
WEBHOOK_URL=https://your-public-tunnel-url-here.com

# -----------------------------------------------------------------------------
# 7. THREAT INTELLIGENCE APIS (FLOW B TRIAGE)
# -----------------------------------------------------------------------------
# VirusTotal v3 API Key (Dapatkan di https://www.virustotal.com/gui/my-apikey)
VT_API_KEY=your_virustotal_api_key_here

# urlscan.io API Key (Dapatkan di https://urlscan.io/user/profile/)
URLSCAN_API_KEY=your_urlscan_api_key_here

# -----------------------------------------------------------------------------
# 8. PRESENTATION LAYER — NEXT.JS DASHBOARD
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_BOT_USERNAME=your_telegram_bot_username
