# =============================================================================
# AFFERENT LAB/DEMO CONFIGURATION
# Copy to .env. Never commit real credentials.
# Generate secrets: python -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================

# Runtime security. DEV_BYPASS_AUTH and FLASK_DEBUG must remain false outside
# a local developer workstation; Flask rejects unsafe staging/production boot.
APP_ENV=production
NODE_ENV=production
DEV_BYPASS_AUTH=false
FLASK_DEBUG=false
SECRET_KEY=replace-with-random-secret
ADMIN_PASSWORD=replace-with-strong-bootstrap-password
SERVICE_API_KEY=replace-with-random-internal-service-key
BOOTSTRAP_ADMIN_EMAIL=admin@humanfirewall.local
# Comma-separated dashboard origins. Include the exact hostname users type in
# the browser; localhost and 127.0.0.1 are distinct cookie domains.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY_HEADERS=true

# Public/internal application URLs. For a remote lab, replace 127.0.0.1 with the
# Tailscale IP or DNS name of the lab server; never edit application code.
WEB_BIND_IP=127.0.0.1
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:5000
API_URL=http://flask_api:5000
SERVER_BASE_URL=http://127.0.0.1:5000
SIMULATION_BASE_URL=http://127.0.0.1:8080
AUTH_COOKIE_SECURE=false

# OTP and education use Mailpit only in this demo Compose. External SMTP
# delivery is Future Work, not part of the final submission.
MAILPIT_BIND_IP=127.0.0.1
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=AFFERENT Security <security@afferent.local>
SMTP_SECURITY=none
SMTP_TIMEOUT_SECONDS=10
REAL_SMTP_ENABLED=false
# Only low-score active employees may receive warnings in Mailpit.
# Strict comparison: score < threshold; default is below 60 out of 200.
EDUCATION_EMAIL_ENABLED=true
# Default: manual approval from SOC/GRC inbox. Optional automatic education.
EDUCATION_AUTO_ENABLED=false
EDUCATION_SCORE_THRESHOLD=60
# Minimum interval between education warnings; pending retries prevent duplicates.
EDUCATION_COOLDOWN_SECONDS=86400
OTP_PEPPER=replace-with-random-otp-pepper
AUTH_AUDIT_PEPPER=replace-with-random-audit-pepper
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT_WINDOW_SECONDS=900
OTP_MAX_REQUESTS_PER_WINDOW=5
# A login lasts one day from sign-in, then the person must sign in again.
AUTH_SESSION_TTL_SECONDS=86400
PASSWORD_MIN_LENGTH=12

# Centralized proxy listener. Keep loopback locally. For a bridged-VM lab set
# WEB_BIND_IP and PROXY_BIND_IP to 0.0.0.0 (or the host LAN IP), then restrict
# TCP 3000/5000/3128 to the private lab subnet in Windows Firewall.
PROXY_BIND_IP=127.0.0.1
PROXY_PORT=3128
PUBLIC_PROXY_URL=http://127.0.0.1:3128
# Reserved .invalid URL used by the employee dashboard to prove that the
# browser is actually traversing Squid. Do not point this at a real domain.
PUBLIC_PROXY_PROBE_URL=http://proxy-check.afferent.invalid/__afferent_probe__
# closed prevents the first request from bypassing inspection when the backend
# is unavailable. Explicit open trades this guarantee for Internet availability.
PROXY_FAIL_MODE=closed
PROXY_DECISION_TIMEOUT_SECONDS=2.5
# Reconcile active tunnels with committed policy; real latency includes backend
# response time. The opaque TCP relay needs no elevated container capability.
PROXY_ENFORCEMENT_API_URL=http://flask_api:5000/api/proxy/enforcement/check
PROXY_REVOCATION_INTERVAL_SECONDS=0.5
# Concurrent connections, including incomplete first requests (demo: 5-8 users).
PROXY_MAX_CONNECTIONS=1000
# Device authorization follows the default 24-hour login session. The UI's
# connected indicator still uses PROXY_CONNECTED_WINDOW_SECONDS below.
PROXY_DEVICE_TTL_SECONDS=86400
PROXY_CONNECTED_WINDOW_SECONDS=90
PROXY_BOOTSTRAP_ALLOW_DOMAINS=
PROXY_ML_VERDICT_TTL_SECONDS=604800
PROXY_ML_CACHE_TTL_SECONDS=3600
PROXY_SOC_CACHE_TTL_SECONDS=86400
PROXY_UNKNOWN_RETRY_SECONDS=60
PROXY_IDEMPOTENCY_TTL_SECONDS=600
PROXY_TRAFFIC_RETENTION_DAYS=30
PROXY_AUDIT_RETENTION_DAYS=365

# scripts/setup_lab.py generates the Git-ignored .env.proxy.local with these
# secrets plus POSTGRES_DB, POSTGRES_USER and POSTGRES_PASSWORD. It includes
# ML_WEBHOOK_SECRET as well, since backend/workers read that local file.
PROXY_DB_NAME=afferent_proxy
PROXY_DB_USER=afferent_proxy_app
PROXY_DB_PASSWORD=replace-with-random-db-password
REDIS_PASSWORD=replace-with-random-redis-password
PROXY_IDENTITY_PEPPER=replace-with-random-ip-hmac-pepper

# Proxy uses a local domain-only ML artifact by default. External HMAC ML
# can override it. Employee URL scans/reports use VT/urlscan, not this model.
# Actual Unknown predictions remain allowed for SOC review; pending/error
# predictions are denied temporarily and never become a durable blacklist.
ML_SCANNER_URL=
ML_LOCAL_ENABLED=true
ML_DOMAIN_MODEL_DIR=/app/models/domain_v3
ML_CPU_THREADS=2
ML_URL_CACHE_TTL_SECONDS=3600
ML_WEBHOOK_SECRET=replace-with-random-hmac-secret-shared-with-ml
ML_TLS_CA_BUNDLE=
ML_SCANNER_TIMEOUT_SECONDS=1.5
ML_BLOCK_CONFIDENCE_THRESHOLD=0.85
ML_ALLOW_CONFIDENCE_THRESHOLD=0.80

# SQLite stays in place for legacy auth/phishing/gamification data.
DB_PATH=/app/instance/human_firewall.db

# GoPhish simulation engine. Keep the CA bundle configured so TLS fails closed.
GOPHISH_API_KEY=replace-with-gophish-api-key
GOPHISH_ADMIN_BIND_IP=127.0.0.1
GOPHISH_API_URL=https://gophish:3333
GOPHISH_CERT_DIR=./secrets/gophish-pki
GOPHISH_CA_BUNDLE=/etc/afferent-ca/gophish-ca.crt
# Public URLs used by dashboard links and campaign recipients. Set the phishing
# URL to the host LAN IP for VM testing; never use localhost on the employee VM.
GOPHISH_PHISH_PUBLIC_URL=http://127.0.0.1:8080
GOPHISH_ADMIN_PUBLIC_URL=https://localhost:3333
MAILPIT_PUBLIC_URL=http://127.0.0.1:8025
# Background GoPhish telemetry sync, independent of an open admin dashboard.
GOPHISH_SYNC_ENABLED=true
# Education after demo form submission; use the dashboard address reachable
# from the VM. Empty derives SERVER_BASE_URL hostname on default port 3000.
SIMULATION_EDUCATION_URL=
# Dashboard link on the proxy block page, reachable from employee VM/LAN.
# Empty derives SERVER_BASE_URL hostname on port 3000; no fixed employee IP.
PROXY_PORTAL_URL=

# Optional AI assistant providers (not used for proxy verdicts).
# false renders a labelled telemetry baseline without external LLM latency.
AI_HEATMAP_USE_LLM=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=
FIRECRAWL_API_KEY=

# Employee URL checks/reports and private file scans (never the proxy hot path).
# Empty keys produce Unknown. Only link reports appear in the SOC inbox.
VT_API_KEY=
URLSCAN_API_KEY=

# URL/file scans and link reports share this VT v3 budget across API and worker.
# Match the quota attached to your API key; a higher value grants no entitlement.
VT_REQUESTS_PER_MINUTE=4
# Private file scans: all file extensions, max 1-10 MB/file, 64 MB queued bytes.
# No preview, execution, download, SOC report, scoring or automatic blocking.
FILE_SCAN_MAX_MB=10
# Original bytes are logically deleted after submission/completion or expiry.
FILE_SCAN_RETENTION_SECONDS=3600
# Existing PDF_REPORT_MAX_MB/RETENTION_SECONDS are accepted as legacy fallbacks.

# Optional SOC advice, never proxy auto-blocking. Requires Compose profile llm
# and an explicit model pull. No cloud fallback or public Ollama API port.
LOCAL_LLM_ENABLED=false
LOCAL_LLM_URL=http://local_llm:11434
LOCAL_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
# json for the general baseline; class_token only for the evaluated
# afferent-hostname-06b:v1 fine-tuned artifact. See LOCAL_LLM_AND_REPORTS.md.
LOCAL_LLM_OUTPUT_MODE=json
LOCAL_LLM_TIMEOUT_SECONDS=45
