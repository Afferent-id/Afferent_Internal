    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lookupRes = $('VT Lookup Hash').item.json;\nlet vtResult = {};\n\nif (lookupRes && lookupRes.data && lookupRes.data.attributes) {\n  vtResult = lookupRes;\n} else if ($('VT Get File Result')) {\n  vtResult = $('VT Get File Result').item.json || {};\n}\n\nconst origInput = $('Parse Input').item.json;\nconst computeData = $('Compute Hash') ? $('Compute Hash').item.json : {};\n\nconst stats = vtResult.data?.attributes?.last_analysis_stats || vtResult.data?.attributes?.stats || {};\nconst vtMalicious = stats.malicious || 0;\nconst vtSuspicious = stats.suspicious || 0;\nconst vtTotal = Object.values(stats).reduce((a, b) => a + b, 0) || 60;\n\nconst totalThreats = vtMalicious + vtSuspicious;\nconst fileHash = vtResult.data?.id || vtResult.meta?.file_info?.sha256 || computeData.sha256 || 'N/A';\nconst fileName = origInput.file_name || 'attachment.txt';\n\nlet severity = 'clean';\nlet isDangerous = false;\n\n// Generic Threat Thresholds (Industry Standard)\nif (totalThreats >= 5) {\n  isDangerous = true;\n  severity = 'high';\n} else if (totalThreats >= 2) {\n  isDangerous = true;\n  severity = 'medium';\n} else if (totalThreats >= 1) {\n  isDangerous = true;\n  severity = 'low';\n}\n\nconst verdictText = isDangerous\n  ? (totalThreats + '/' + vtTotal + ' engines flagged threat')\n  : ('Clean (0/' + vtTotal + ' engines flagged threat)');\n\nreturn {\n  json: {\n    is_dangerous: isDangerous,\n    severity: severity,\n    vt_verdict: verdictText,\n    file_hash: fileHash,\n    file_name: fileName,\n    chat_id: origInput.chat_id,\n    reporter_name: origInput.reporter_name\n  }\n};"
      },
