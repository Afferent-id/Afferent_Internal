      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $input.item.json;\nconst msg = body.message || body.edited_message || body.channel_post || (body.text ? body : null);\n\nif (!msg) {\n  return {\n    json: {\n      type: \"invalid\",\n      chat_id: body.chat ? body.chat.id : (body.from ? body.from.id : null),\n      reporter_name: \"User\"\n    }\n  };\n}\n\nconst chat_id = msg.chat ? msg.chat.id : (msg.from ? msg.from.id : null);\nconst reporter_name = msg.from ? (msg.from.first_name || 'User') : 'User';\n\nif (msg.text) {\n  const text = msg.text.trim();\n\n  // Command, email, or 6-digit OTP\n  if (text.startsWith('/') || text.includes('@') || /^\\d{6}$/.test(text)) {\n    return {\n      json: {\n        type: \"command\",\n        command: text,\n        chat_id: chat_id,\n        reporter_name: reporter_name\n      }\n    };\n  }\n\n  const urlRegex = /^https?:\\/\\/\\S+$/i;\n  if (urlRegex.test(text)) {\n    return {\n      json: {\n        type: \"url\",\n        url: text,\n        chat_id: chat_id,\n        reporter_name: reporter_name\n      }\n    };\n  }\n}\n\nif (msg.document) {\n  return {\n    json: {\n      type: \"file\",\n      file_id: msg.document.file_id,\n      file_name: msg.document.file_name || \"attachment\",\n      mime_type: msg.document.mime_type || \"application/octet-stream\",\n      chat_id: chat_id,\n      reporter_name: reporter_name\n    }\n  };\n}\n\nreturn {\n  json: {\n    type: \"invalid\",\n    chat_id: chat_id,\n    reporter_name: reporter_name\n  }\n};"
      },
