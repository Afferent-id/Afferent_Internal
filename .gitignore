# GGUF quantized model (940 MB)
Finetune LLM/qwen2.5-1.5b-firewall-agent_gguf/
# HuggingFace tokenizer download cache
Finetune LLM/huggingface_tokenizers_cache/
# Unsloth compiled cache (auto-generated, not needed)
Finetune LLM/unsloth_compiled_cache/
# HuggingFace .cache inside model folder
Finetune LLM/qwen2.5-1.5b-firewall-agent/.cache/
